VITE_GHL_API_KEY=your_ghl_api_key_here
VITE_GHL_LOCATION_ID=your_ghl_location_id_here
VITE_N8N_BARCODE_WEBHOOK=https://n8n.growthlio.com/webhook/palette-moms-barcode-lookup
VITE_GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
VITE_GOOGLE_CSE_ID=your_google_custom_search_engine_id_here
# Staff user-level auth (Supabase). Required on any real deploy, or the write
# endpoints fail closed (503). The server verifies the user's access token
# against this project; the anon key is safe to ship in the bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
